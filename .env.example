# Salin menjadi .env (berkas .env TIDAK boleh di-commit). Semua nilai di sini hanya dibaca oleh server.

# --- Midtrans (pembayaran QRIS) ---
# Server key dari dashboard Midtrans. Sandbox: awalan "SB-Mid-server-". JANGAN dimasukkan ke frontend/hotspot.
MIDTRANS_SERVER_KEY=
# true = produksi (api.midtrans.com), selain itu sandbox (api.sandbox.midtrans.com)
MIDTRANS_IS_PRODUCTION=false
# Acquirer QRIS di Midtrans (default gopay)
MIDTRANS_QRIS_ACQUIRER=gopay

# --- Router yang diakses SERVER untuk menerbitkan akun otomatis ---
# Pakai user router khusus dengan hak minimum (read, write, api, rest-api), bukan admin.
ROUTER_HOST=
ROUTER_PORT=
ROUTER_USER=
ROUTER_PASSWORD=
# auto | rest | binary
ROUTER_PROTOCOL=auto

# --- Halaman beli ---
# Alamat halaman login hotspot (tanpa username/password), contoh: http://hotspot.tkj/login
HOTSPOT_LOGIN_URL=

# --- Halaman beli yang disajikan router (hotspot/beli.html) ---
# Asal (origin) halaman hotspot yang boleh memanggil API /api/shop/* dari browser pelanggan (CORS). Pisahkan dengan koma.
# Format persis skema://host[:port] tanpa path/garis miring akhir. Contoh dengan dua profil hotspot:
# SHOP_ALLOWED_ORIGINS=http://hotspot.tkj,http://192.168.20.129,http://wifi.net,http://192.168.100.1
# Kosong = tanpa CORS (halaman /beli yang disajikan backend sendiri tetap berfungsi).
SHOP_ALLOWED_ORIGINS=

# Nama host (selain IP dan localhost) yang boleh dipakai pelanggan/Midtrans untuk membuka server ini, mis. lewat
# domain atau tunnel. Tanpa ini Vite menolak permintaan dengan Host tak dikenal ("Blocked request. This host is not allowed").
SHOP_ALLOWED_HOSTS=

# --- Keamanan & data ---
# IP tambahan yang boleh membuka API admin (pisahkan dengan koma). Selalu diizinkan: localhost.
# Permintaan lewat proxy/tunnel (ada header X-Forwarded-For dkk.) SELALU ditolak untuk API admin.
ADMIN_ALLOWED_IPS=
# Folder data transaksi (berisi shop-store.json). Jangan di-commit; cadangkan secara berkala.
SHOP_DATA_DIR=data
# Pesanan final lebih tua dari ini dihapus otomatis (hari)
SHOP_RETENTION_DAYS=90
# Percobaan ulang penerbitan akun saat router tidak terjangkau
SHOP_RETRY_INTERVAL_MS=30000
SHOP_RETRY_MAX_ATTEMPTS=30
SHOP_RETRY_BASE_DELAY_MS=30000
SHOP_RETRY_MAX_DELAY_MS=600000
